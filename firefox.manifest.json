{
  "name": "几枝·增强版",
  "version": "2.5.2",
  "description": "以中国传统色、动态水墨山峦和古诗词替换浏览器新标签页。基于几枝的非官方增强版。",
  "permissions": [],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_icon": {
      "16": "./static/icons/jizhi-16.png",
      "32": "./static/icons/jizhi-32.png",
      "64": "./static/icons/jizhi-64.png",
      "128": "./static/icons/jizhi-128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "./static/icons/jizhi-16.png",
    "32": "./static/icons/jizhi-32.png",
    "64": "./static/icons/jizhi-64.png",
    "128": "./static/icons/jizhi-128.png"
  },
  "manifest_version": 3,
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "homepage_url": "https://github.com/Amy22707/jizhi",
  "browser_specific_settings": {
    "gecko": {
      "id": "jizhi-enhanced@amy22707.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "optional": [
          "searchTerms",
          "browsingActivity"
        ],
        "required": [
          "none"
        ]
      }
    }
  }
}
